# Chain the app reads and writes: 46630 (Robinhood Chain testnet) or 31337 (local anvil).
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Optional override for public role profiles in the app header.
# For example "Borrower:0x...,Lender:0x...,Liquidator:0x..."
NEXT_PUBLIC_DEMO_ACCOUNTS=
