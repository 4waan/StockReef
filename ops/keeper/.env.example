# Copy to .env and fill in. Never commit .env.
RPC_URL=http://127.0.0.1:8545
# Optional: the keeper only simulates without a key, or when --execute is not given.
KEEPER_KEY=
# Optional: pays for trims. Defaults to KEEPER_KEY.
LIQUIDATOR_KEY=
# Optional, demo deployments only: the DemoController operator key for `feed` mode.
OPERATOR_KEY=
