			"phrases": [
				{
					"text": "Tesla's token can be traded all weekend, but the real stock market closes on Friday afternoon.",
					"start": 513,
					"end": 709
				},
				{
					"text": "If Tesla opens much lower on Monday, a loan can go bad before anyone can react.",
					"start": 713,
					"end": 909
				}
