			"graphic": true,
			"clips": [],
			"urls": [],
			"phrases": [
				{
					"text": "Three billion dollars of stocks are on chain, yet almost none are borrowed against.",
					"start": 981,
					"end": 1152
				},
				{
					"text": "Today's apps use one safety limit all week, even before a weekend.",
					"start": 1157,
					"end": 1304
				},
				{
					"text": "In a big weekend drop, that costs lenders four times more.",
					"start": 1308,
					"end": 1443
				}
			]
		},
